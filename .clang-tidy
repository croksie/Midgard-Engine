---
# Midgard-Engine .clang-tidy configuration
# Conçu pour un moteur C++20 avec Vulkan / OpenGL
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-narrowing-conversions,
  performance-*,
  modernize-*,
  -modernize-use-trailing-return-type,
  -modernize-avoid-c-arrays,
  readability-*,
  -readability-magic-numbers,
  -readability-avoid-const-params-in-decls,
  -readability-function-cognitive-complexity,
  -readability-implicit-bool-conversion,
  cppcoreguidelines-*,
  -cppcoreguidelines-pro-bounds-pointer-arithmetic,
  -cppcoreguidelines-pro-type-reinterpret-cast,
  -cppcoreguidelines-owning-memory,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-pro-type-member-init

# Filtre pour n'analyser QUE le code source du projet (ignore vcpkg, Vulkan SDK, ImGui, etc.)
HeaderFilterRegex: 'src/.*'

# Pas de blocage bloquant la compilation en dev quotidien
WarningsAsErrors: ''

# Options avancées et convention de nommage du projet
CheckOptions:
  # Conventions de nommage (PascalCase classes, camelCase fonctions, m_ membres privés)
  readability-identifier-naming.NamespaceCase: lower_case
  readability-identifier-naming.ClassCase: CamelCase
  readability-identifier-naming.StructCase: CamelCase
  readability-identifier-naming.FunctionCase: camelCase
  readability-identifier-naming.MethodCase: camelCase
  readability-identifier-naming.PrivateMemberPrefix: m_
  readability-identifier-naming.ProtectedMemberPrefix: m_
  readability-identifier-naming.PublicMemberCase: camelCase
  readability-identifier-naming.VariableCase: camelCase
  readability-identifier-naming.ParameterCase: camelCase
  readability-identifier-naming.ConstantCase: UPPER_CASE
  readability-identifier-naming.EnumCase: CamelCase
  readability-identifier-naming.EnumConstantCase: UPPER_CASE

  # Détection des copies d'arguments et de retours
  performance-unnecessary-value-param.AllowedTypes: ''
